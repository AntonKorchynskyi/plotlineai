# --- Postgres ---
POSTGRES_DB=plotlineai
POSTGRES_USER=plotlineai
POSTGRES_PASSWORD=change-me-locally

# --- Web / AI (web service only) ---
# Supplied by you. Without it, /api/suggest and /api/chart-spec answer 503 AI_UNAVAILABLE.
OPENAI_API_KEY=
AI_MODEL=gpt-5-nano
# Cost circuit breaker: provider calls allowed per UTC day, across all clients.
AI_DAILY_CALL_LIMIT=500
# Token buckets guarding the two AI routes. Per client: a burst of 10, one more every 6s.
# Global, across all clients: a burst of 30, one more every 2s.
RATE_LIMIT_CLIENT_BURST=10
RATE_LIMIT_CLIENT_REFILL_MS=6000
RATE_LIMIT_GLOBAL_BURST=30
RATE_LIMIT_GLOBAL_REFILL_MS=2000

# --- Backend when run outside docker (mvn spring-boot:run) ---
# These values are not read automatically outside Docker - export them in your
# shell (or rely on the application.yaml localhost defaults, which match the dev
# overlay).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/plotlineai
SPRING_DATASOURCE_USERNAME=plotlineai
SPRING_DATASOURCE_PASSWORD=change-me-locally
