# Local stack settings (docker compose). On AWS these come from CDK (infra/), not from here.

# --- Web / AI (web service only) ---
# Supplied by you. Without it, /api/suggest and /api/chart-spec answer 503 AI_UNAVAILABLE.
# On AWS the key lives in SSM Parameter Store instead (docs/deploy-aws.md).
OPENAI_API_KEY=
AI_MODEL=gpt-5-nano
# The provider's base URL is api.openai.com. docker-compose.e2e.yml points it at e2e/ai-stub
# (OPENAI_BASE_URL); base compose never passes it, because an empty value is an error.
#
# Rate limits, per 60 s window, kept in DynamoDB (DynamoDB Local under compose).
# The two AI routes together:
RATE_LIMIT_AI_CLIENT_LIMIT=10
RATE_LIMIT_AI_GLOBAL_LIMIT=30
# Upload presigns, upload finalizes and shares through /api/backend:
RATE_LIMIT_WRITE_CLIENT_LIMIT=8
RATE_LIMIT_WRITE_GLOBAL_LIMIT=60
# Chart renders through /api/backend:
RATE_LIMIT_RENDER_CLIENT_LIMIT=30
RATE_LIMIT_RENDER_GLOBAL_LIMIT=1200
# Proxies in front of web that append the client address to X-Forwarded-For. Caddy is one;
# set 2 only if another proxy is added in front of it.
TRUSTED_PROXY_HOPS=1

# --- Api ---
# Cost circuit breaker: provider calls allowed per UTC day, across all clients. The count is
# kept in DynamoDB, so restarting web or api does not reset it.
AI_DAILY_CALL_LIMIT=500
# Uploads accepted per UTC day, across all clients: the bound on S3 storage.
UPLOAD_DAILY_LIMIT=300
# How long an uploaded dataset lives (ISO-8601 duration). Shares keep their own snapshot.
DATASET_TTL=PT24H

# --- Proxy (the local stack's only ingress) ---
# ":80" serves plain HTTP on localhost:3000.
SITE_ADDRESS=:80
