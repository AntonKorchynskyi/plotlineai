# The only ingress of the local stack. Everything else sits on the internal network behind it.
# On AWS, CloudFront plays this part and Caddy is not deployed.
#
# Caddy trusts no upstream proxy (no trusted_proxies), so it drops any X-Forwarded-For a
# client sends and writes the socket address instead. Next only fills that header when it
# is absent, so web's rate limiter keys on the real client address.
{
	admin off
	servers {
		# A slow client cannot hold a connection open forever.
		timeouts {
			read_body 30s
			read_header 10s
			idle 2m
		}
	}
}

# Liveness of the proxy itself, for the compose healthcheck, on a port that is never published.
http://:9000 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::80} {
	# The largest legitimate body is a CSV upload: a 5 MB file PUT to /local-s3.
	request_body {
		max_size 6MB
	}
	encode zstd gzip
	header {
		-Server
		-Via
		defer
	}
	# The browser PUTs uploads to S3Mock through here, so locally they are same-origin and
	# need neither CORS nor a CSP exception. On AWS they go to the S3 bucket itself.
	handle_path /local-s3/* {
		reverse_proxy s3:9090
	}
	handle {
		reverse_proxy web:3000
	}
}
