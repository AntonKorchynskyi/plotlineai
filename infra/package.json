{
  "name": "plotlineai-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:lambda": "esbuild lambda/event-archiver/index.ts --bundle --platform=node --target=node24 --format=cjs --minify --outfile=lambda/event-archiver/dist/index.js && esbuild lambda/redshift-loader/index.ts --bundle --platform=node --target=node24 --format=cjs --minify --loader:.sql=text --outfile=lambda/redshift-loader/dist/index.js",
    "synth": "cdk synth",
    "cdk": "cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-redshift-data": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.1",
    "aws-cdk": "2.1144.0",
    "esbuild": "^0.28.2",
    "tsx": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
}
